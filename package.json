{
  "name": "agentsurface",
  "version": "0.1.0",
  "description": "Fleet integrations over the herdr surface: host fleet TUIs and realize their session directives",
  "private": false,
  "keywords": [
    "ai",
    "agent",
    "herdr",
    "host",
    "launcher"
  ],
  "homepage": "https://github.com/possibilities/agentsurface#readme",
  "bugs": "https://github.com/possibilities/agentsurface/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentsurface.git"
  },
  "type": "module",
  "bin": {
    "agentsurface": "./src/main.ts"
  },
  "files": [
    "src",
    "plugin",
    "directive.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000",
    "generate:schemas": "bun run scripts/generate-schema.ts && biome check --write directive.schema.json",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
